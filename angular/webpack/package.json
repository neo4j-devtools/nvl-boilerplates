    "@neo4j-nvl/base": "^0.3.9",
    "@neo4j-nvl/interaction-handlers": "^0.3.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.4",
    "@angular/cli": "^20.1.4",
    "@angular/compiler-cli": "^20.1.0",
    "typescript": "~5.8.2"
